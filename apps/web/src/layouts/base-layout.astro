---
import '@/styles/globals.css';
import SectionNav from '@/components/section-nav.astro';
import SeoHead from '@/components/seo-head.astro';
import SiteFooter from '@/components/site-footer.astro';
import TopBar from '@/components/top-bar.astro';
import { SEO } from '@/config/seo';
import { SITE } from '@/content/site';
---

<!doctype html>
<html lang={SEO.language}>
  <head>
    <SeoHead />
    {/* Before the first paint. html.js: there is JavaScript. html.motion: and motion is welcome, so
        motion.css runs the entrances from their starting point from the first frame. html.motion-on: they
        did start; if not in 2.5 s, html.motion goes away and everything shows still. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('motion');
        addEventListener('animationstart', () => root.classList.add('motion-on'), { once: true, capture: true });
        setTimeout(() => root.classList.contains('motion-on') || root.classList.remove('motion'), 2500);
      })();
    </script>
  </head>

  <body class="bg-paper text-ink">
    <a href="#contenido" class="skip-link rounded-xl border-3 border-ink bg-brand px-4 py-2 font-display font-bold text-ink shadow-hard-sm">{SITE.skipLink}</a>
    <TopBar />

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
    <SectionNav />

    <script>
      import '@/scripts/anchors';
      import '@/scripts/motion';
    </script>
  </body>
</html>
