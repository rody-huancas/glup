---
import { Image } from 'astro:assets';
import logo from '@docs/logo.png';
import GlupLogo from '@/components/art/glup-logo.astro';
import { SITE } from '@/content/site';
import { sharpImage } from '@/lib/image-widths';
---

<header class="fixed inset-x-0 top-0 z-50 h-top border-b-3 border-ink bg-paper">
  <div class="mx-auto flex h-full max-w-page items-center justify-between gap-4 px-4 md:px-8">
    <a href="#inicio" class="flex items-center gap-2" data-home>
      <Image class="h-7 w-auto" {...sharpImage({ picture: logo, shown: 30, eager: true })} />
      <GlupLogo class="w-20" />
      <span class="sr-only">{SITE.name}</span>
    </a>
    <p class="font-mono text-xs font-medium text-ink-soft md:text-sm">{SITE.status(__GLUP_VERSION__)}</p>
  </div>
</header>
