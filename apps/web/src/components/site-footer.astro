---
import { Image } from 'astro:assets';
import logo from '@docs/logo.png';
import GlupLogo from '@/components/art/glup-logo.astro';
import TextLink from '@/components/text-link.astro';
import { LINKS } from '@/config/links';
import { FOOTER } from '@/content/footer';
import { SITE } from '@/content/site';
import { sharpImage } from '@/lib/image-widths';

const links = [
  { label: FOOTER.license, href: LINKS.license },
  { label: FOOTER.github,  href: LINKS.repository },
  { label: FOOTER.notices, href: LINKS.notices },
  { label: FOOTER.author,  href: LINKS.author },
];
---

<footer class="border-t-3 border-ink bg-paper-deep">
  <div class="mx-auto flex max-w-page flex-col gap-8 px-4 py-12 md:flex-row md:items-end md:justify-between md:px-8">
    <div class="flex items-center gap-4">
      <Image class="h-16 w-auto" {...sharpImage({ picture: logo, shown: 68 })} />
      <div>
        <p><GlupLogo class="w-36" /><span class="sr-only">{SITE.name}</span></p>
        <p class="text-ink-soft">{FOOTER.tagline}</p>
      </div>
    </div>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-sm font-medium md:justify-end">
      {links.map((link) => (
        <li><TextLink href={link.href} class="hover:decoration-coral-deep">{link.label}</TextLink></li>
      ))}
    </ul>
  </div>
</footer>
