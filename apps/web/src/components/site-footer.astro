---
import { Image } from 'astro:assets';
import logo from '@docs/logo.png';
import { LINKS } from '@/config/links';
import { FOOTER } from '@/content/footer';
import { SITE } from '@/content/site';

const links = [
  { label: FOOTER.license, href: LINKS.license },
  { label: FOOTER.github,  href: LINKS.repository },
  { label: FOOTER.notices, href: LINKS.notices },
  { label: FOOTER.author,  href: LINKS.author },
];
---

<footer class="border-t-3 border-ink bg-paper-deep">
  <div class="mx-auto flex max-w-page flex-col gap-8 px-4 py-12 md:flex-row md:items-end md:justify-between md:px-8">
    <div class="flex items-center gap-4">
      <Image src={logo} width={128} alt="" class="size-16" />
      <div>
        <p class="font-display text-4xl font-extrabold tracking-tight">{SITE.name}</p>
        <p class="text-ink-soft">{FOOTER.tagline}</p>
      </div>
    </div>
    <div class="flex flex-col gap-3 md:items-end">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-sm font-medium">
        {links.map((link) => (
          <li><a href={link.href} class="underline decoration-2 underline-offset-4 hover:decoration-coral-deep">{link.label}</a></li>
        ))}
      </ul>
      <p class="font-mono text-sm text-ink-soft">{FOOTER.place}</p>
    </div>
  </div>
</footer>
