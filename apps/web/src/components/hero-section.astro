---
import BubbleArt from '@/components/art/bubble-art.astro';
import CursorArt from '@/components/art/cursor-art.astro';
import FileTile from '@/components/art/file-tile.astro';
import FolderArt from '@/components/art/folder-art.astro';
import GlupLogo from '@/components/art/glup-logo.astro';
import SparkleArt from '@/components/art/sparkle-art.astro';
import ButtonLink from '@/components/button-link.astro';
import DownloadNote from '@/components/download-note.astro';
import GlupFigure from '@/components/glup-figure.astro';
import { LINKS } from '@/config/links';
import { HERO } from '@/content/hero';
import type { FileKind } from '@/types/content.types';

interface IFallingFile {
  kind   : FileKind;
  place  : string;
  tilt   : string;
  depth  : number;
  extra? : boolean;
}

// Along a diagonal toward Glup's mouth; the extra ones only on wide screens.
const FILES: IFallingFile[] = [
  { kind: 'pdf',   place: 'top-0 left-0 w-1/5',        tilt: '-rotate-12', depth: 0.5 },
  { kind: 'photo', place: 'top-1/6 left-1/4 w-1/5',    tilt: 'rotate-6',   depth: 0.35 },
  { kind: 'voice', place: 'top-0 left-1/2 w-1/6',      tilt: 'rotate-12',  depth: 0.7,  extra: true },
  { kind: 'video', place: 'top-2/5 left-0 w-1/6',      tilt: '-rotate-6',  depth: 0.25, extra: true },
  { kind: 'text',  place: 'top-1/3 left-1/2 w-1/6',    tilt: '-rotate-6',  depth: 0.2 },
  { kind: 'zip',   place: 'top-1/10 right-0 w-1/6',    tilt: 'rotate-3',   depth: 0.55, extra: true },
];
---

<section id="inicio" aria-labelledby="inicio-title" class="paper-grid relative overflow-hidden border-b-3 border-ink" data-section data-hero>
  <div class="mx-auto grid max-w-page items-center gap-10 px-4 pt-10 pb-16 md:px-8 lg:grid-cols-12 lg:pt-16 lg:pb-24">
    <div class="relative z-10 lg:col-span-6">
      <p class="inline-flex items-center gap-2 rounded-full border-2 border-ink bg-white px-3 py-1 font-mono text-xs font-semibold tracking-widest uppercase">
        <span class="size-2.5 rounded-full border-2 border-ink bg-brand" aria-hidden="true"></span>
        {HERO.label}
      </p>
      <h1 id="inicio-title" class="mt-2" aria-label={HERO.title}>
        <span class="sr-only">{HERO.title}</span>
        <GlupLogo live class="w-full max-w-sm sm:max-w-md lg:max-w-lg" />
      </h1>
      <p class="mt-6 max-w-xl text-lead text-ink-soft">{HERO.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <ButtonLink href={LINKS.download}>
          <svg class="size-5" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path class="art-thin fill-none stroke-current" d="M12 4 V15 M7 10 L12 15 L17 10 M5 20 H19" />
          </svg>
          {HERO.download}
        </ButtonLink>
        <ButtonLink href={LINKS.repository} variant="secondary">{HERO.github}</ButtonLink>
      </div>
      <DownloadNote class="mt-3 text-ink-soft" />
      <ul class="mt-6 flex flex-col gap-1 font-mono text-sm font-medium text-ink-soft sm:flex-row sm:flex-wrap sm:gap-x-3">
        {HERO.promises.map((promise, index) => (
          <li class="flex items-center gap-3">
            {index > 0 && <span class="hidden sm:inline" aria-hidden="true">·</span>}
            {promise}
          </li>
        ))}
      </ul>
    </div>

    <div class="relative mx-auto aspect-square w-full max-w-md lg:col-span-6 lg:max-w-xl">
      <div class="absolute inset-0" aria-hidden="true">
        {FILES.map((file, index) => (
          <div class:list={['absolute', file.place, file.extra && 'art-extra']} data-depth={file.depth}>
            <div data-float><div data-snack data-enter={index + 2}><FileTile kind={file.kind} class={`w-full ${file.tilt}`} /></div></div>
          </div>
        ))}

        <div class="absolute top-1/8 left-1/8 w-1/10" data-depth="0.6"><div data-enter="8"><CursorArt class="w-full" /></div></div>
        <div class="absolute top-1/3 right-0 w-1/4" data-depth="0.15"><div data-float><div data-hero-bubble data-enter="12"><BubbleArt text={HERO.munch} class="w-full" /></div></div></div>
        <div class="absolute top-3/5 left-1/4 w-1/12" data-depth="0.3"><div data-float><div data-enter="9"><SparkleArt class="w-full" /></div></div></div>
        <div class="art-extra absolute top-1/4 right-1/4 w-1/14" data-depth="0.4"><div data-float><div data-enter="10"><SparkleArt accent="coral" class="w-full" /></div></div></div>
        <div class="art-extra absolute bottom-0 left-0 w-1/4" data-depth="0.1"><div data-float><div data-enter="11"><FolderArt class="w-full" /></div></div></div>

        <div class="absolute right-1/12 bottom-0 w-3/5" data-hero-glup data-enter="1">
          <GlupFigure width={345} eager wave />
        </div>
      </div>

      {/* Only with motion (hero-mascot.ts shows it): Glup jumps and waves. */}
      <button type="button" class="absolute right-1/12 bottom-0 aspect-square w-3/5 cursor-pointer rounded-full" aria-label={HERO.poke} hidden data-glup-poke></button>
    </div>
  </div>
</section>
