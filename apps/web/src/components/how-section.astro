---
import { Image } from 'astro:assets';
import BubbleArt from '@/components/art/bubble-art.astro';
import FileTile from '@/components/art/file-tile.astro';
import SparkleArt from '@/components/art/sparkle-art.astro';
import GlupFigure from '@/components/glup-figure.astro';
import RetroWindow from '@/components/retro-window.astro';
import SectionHeading from '@/components/section-heading.astro';
import { HERO } from '@/content/hero';
import { STEPS, STEPS_HEADING } from '@/content/steps';
---

<section id="como-funciona" aria-labelledby="como-funciona-title" class="paper-grid border-b-3 border-ink" data-section>
  <div class="mx-auto max-w-page px-4 py-20 md:px-8 md:py-28">
    <div class="grid items-end gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading heading={STEPS_HEADING} id="como-funciona-title" accent="yellow" />
      </div>

      <div class="relative mx-auto h-80 w-full max-w-sm lg:col-span-5" aria-hidden="true" data-eat-scene>
        <div class="absolute top-0 left-1/3 w-1/4" data-eat-file><FileTile kind="photo" class="w-full rotate-6" /></div>
        <div class="absolute top-1/6 right-0 w-1/3" data-eat-bubble><BubbleArt text={HERO.munch} class="w-full" /></div>
        <div class="absolute top-1/2 left-0 w-1/10" data-eat-sparkle><SparkleArt class="w-full" /></div>
        <div class="absolute right-1/12 bottom-1/4 w-1/12" data-eat-sparkle><SparkleArt accent="lilac" class="w-full" /></div>
        <GlupFigure width={220} class="absolute bottom-0 left-1/2 w-3/5 -translate-x-1/2" />
      </div>
    </div>

    <ol class="mt-16 grid gap-10 lg:grid-cols-3">
      {STEPS.map((step) => (
        <li class="flex flex-col gap-5">
          <div class="flex items-baseline gap-4">
            <span class="font-mono text-sm font-bold" aria-hidden="true">{step.number}</span>
            <h3 class="text-3xl font-extrabold md:text-4xl">{step.title}</h3>
          </div>
          <p class="text-ink-soft">{step.body}</p>
          <RetroWindow title={step.window} accent="yellow" class="mt-auto">
            <Image src={step.image} alt={step.alt} widths={[480, 720, 1080]} sizes="(min-width: 64rem) 24rem, 92vw" class="block aspect-video w-full bg-navy object-cover object-top" loading="lazy" />
          </RetroWindow>
        </li>
      ))}
    </ol>
  </div>
</section>
