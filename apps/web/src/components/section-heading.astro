---
import type { Accent, IHeading } from '@/types/content.types';

interface ISectionHeadingProps {
  heading : IHeading;
  id      : string;
  accent  : Accent;
  dark?   : boolean;
}

type Props = ISectionHeadingProps;

const { heading, id, accent, dark = false } = Astro.props;

const SWATCHES: Record<Accent, string> = {
  brand  : 'bg-brand',
  lilac  : 'bg-lilac',
  coral  : 'bg-coral',
  yellow : 'bg-yellow',
  sky    : 'bg-sky',
  mint   : 'bg-mint',
  silver : 'bg-silver',
};
---

<header class="max-w-3xl">
  <p
    class:list={[
      'inline-flex items-center gap-2 rounded-full border-2 px-3 py-1 font-mono text-xs font-semibold tracking-widest uppercase',
      dark ? 'border-on-navy text-on-navy' : 'border-ink bg-white text-ink',
    ]}
  >
    <span class:list={['size-2.5 rounded-full border-2 border-ink', SWATCHES[accent]]} aria-hidden="true"></span>
    {heading.label}
  </p>
  <h2 id={id} class="mt-5 text-giant font-extrabold">{heading.title}</h2>
  {heading.lead && <p class:list={['mt-5 max-w-2xl text-lead', dark ? 'text-on-navy-soft' : 'text-ink-soft']}>{heading.lead}</p>}
</header>
