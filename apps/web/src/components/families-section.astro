---
import { Image } from 'astro:assets';
import tools from '@tools/tools.json';
import FamilyArt from '@/components/art/family-art.astro';
import RetroWindow from '@/components/retro-window.astro';
import SectionHeading from '@/components/section-heading.astro';
import { FAMILIES, FAMILIES_HEADING, FAMILIES_TEXTS } from '@/content/families';
import { skillsOf } from '@/lib/skills';
---

<section id="que-hace" aria-labelledby="que-hace-title" class="navy-grid on-navy border-b-3 border-ink text-on-navy" data-section>
  <div class="mx-auto max-w-page px-4 py-20 md:px-8 md:py-28">
    <SectionHeading heading={FAMILIES_HEADING} id="que-hace-title" accent="lilac" dark />

    <ul class="mt-14 grid items-start gap-8 md:grid-cols-2 xl:grid-cols-3">
      {FAMILIES.map((family) => (
        <li>
          <RetroWindow title={FAMILIES_TEXTS.window(family.name)} accent={family.accent} class="text-ink">
            <div class:list={['relative flex h-48 items-end border-b-3 border-ink px-4 pt-4', `window-art--${family.accent}`]}>
              <Image src={family.glup} width={family.glup.width} alt="" class="relative z-10 h-44 w-auto" loading="lazy" />
              <FamilyArt family={family.id} class="absolute right-3 bottom-3 h-20" />
            </div>
            <div class="p-5">
              <h3 class="text-4xl font-extrabold">{family.name}</h3>
              <p class="mt-2 text-ink-soft">{family.phrase}</p>
              <p class="mt-5 font-mono text-xs font-semibold tracking-widest text-ink-soft uppercase">{FAMILIES_TEXTS.skills}</p>
              <ul class="mt-2 divide-y-2 divide-dashed divide-paper-deep">
                {skillsOf(tools, family.id).map((skill) => (
                  <li class="py-2">
                    <span class="font-semibold">{skill.title}</span>
                    {skill.description && <span class="text-ink-soft"> · {skill.description}</span>}
                  </li>
                ))}
              </ul>
              {family.notes && (
                <ul class="mt-3 space-y-1 text-sm text-ink-soft">
                  {family.notes.map((note) => <li>{note}</li>)}
                </ul>
              )}
            </div>
          </RetroWindow>
        </li>
      ))}
    </ul>
  </div>
</section>
