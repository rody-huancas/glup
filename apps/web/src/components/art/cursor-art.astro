---
interface ICursorArtProps {
  class? : string;
}

type Props = ICursorArtProps;

const { class: className } = Astro.props;
const arrow                = 'M10 6 L10 62 L24 50 L34 72 L46 66 L36 45 L54 44 Z';
---

<svg class={className} viewBox="0 0 70 84" aria-hidden="true" focusable="false">
  <path class="art-stroke stroke-ink fill-ink" d={arrow} transform="translate(6 7)" />
  <path class="art-stroke stroke-ink fill-white" d={arrow} />
</svg>
