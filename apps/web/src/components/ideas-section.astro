---
// «Glup sigue creciendo»: the ideas form (Tally, no server of ours) in a retro window, with Glup peeking
// over it. The form is loaded by scripts/ideas-form.ts when the section comes near the screen.
import FileTile from '@/components/art/file-tile.astro';
import SparkleArt from '@/components/art/sparkle-art.astro';
import GlupFigure from '@/components/glup-figure.astro';
import RetroWindow from '@/components/retro-window.astro';
import SectionHeading from '@/components/section-heading.astro';
import TextLink from '@/components/text-link.astro';
import { IDEAS, IDEAS_DISCUSSIONS_URL, IDEAS_HEADING, TALLY_EMBED_URL, TALLY_FORM_URL } from '@/content/ideas';
---

<section id="ideas" aria-labelledby="ideas-title" class="paper-grid relative overflow-hidden border-t-3 border-ink" data-ideas>
  <div class="mx-auto grid max-w-page gap-12 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <div class="relative lg:col-span-5">
      <SectionHeading heading={IDEAS_HEADING} id="ideas-title" accent="mint" />

      <p class="mt-6 inline-flex max-w-full items-center gap-3 rounded-xl border-2 border-ink bg-white py-1.5 pr-4 pl-1.5 shadow-hard-sm">
        <span class="shrink-0 rounded-md border-2 border-ink bg-yellow px-2 py-0.5 font-mono text-xs font-bold tracking-widest uppercase">{IDEAS.soon.tag}<span class="sr-only">:</span></span>
        <span class="text-xs font-semibold text-balance">{IDEAS.soon.text}</span>
      </p>

      <div class="art-extra relative mt-14 h-56" aria-hidden="true">
        <div class="absolute top-0 left-4 w-24" data-float><FileTile kind="text" class="w-full -rotate-6" /></div>
        <div class="absolute top-10 left-36 w-20" data-float><FileTile kind="photo" class="w-full rotate-12" /></div>
        <div class="absolute top-2 left-64 w-10" data-float><SparkleArt accent="lilac" class="w-full" /></div>
      </div>
    </div>

    {/* Glup stands behind the window: only its head (eyes and smile) shows over the top edge. */}
    <div class="relative pt-24 lg:col-span-7">
      <div class="absolute top-0 right-10 w-44" aria-hidden="true">
        <GlupFigure width={176} />
      </div>

      <RetroWindow title={IDEAS.window} accent="mint" class="relative z-10">
        <div class="bg-paper p-4 md:p-6">
          <iframe
            data-tally-src={TALLY_EMBED_URL}
            loading="lazy"
            width="100%"
            height={IDEAS.formHeight}
            title={IDEAS.formTitle}
            class="block w-full border-0"
            data-ideas-form
          ></iframe>
          <noscript>
            <iframe src={TALLY_EMBED_URL} loading="lazy" width="100%" height={IDEAS.formHeight} title={IDEAS.formTitle} class="block w-full border-0"></iframe>
          </noscript>
        </div>
      </RetroWindow>

      <div class="mt-5 flex flex-col gap-1 text-sm text-ink-soft">
        <p>{IDEAS.openForm.text} <TextLink href={TALLY_FORM_URL} class="font-semibold text-ink">{IDEAS.openForm.link}</TextLink></p>
        <p>{IDEAS.discuss.text} <TextLink href={IDEAS_DISCUSSIONS_URL} class="font-semibold text-ink">{IDEAS.discuss.link}</TextLink></p>
      </div>
    </div>
  </div>
</section>

<script>
  import '@/scripts/ideas-form';
</script>
