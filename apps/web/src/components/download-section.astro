---
import FileTile from '@/components/art/file-tile.astro';
import SparkleArt from '@/components/art/sparkle-art.astro';
import ButtonLink from '@/components/button-link.astro';
import DownloadNote from '@/components/download-note.astro';
import RetroWindow from '@/components/retro-window.astro';
import SectionHeading from '@/components/section-heading.astro';
import TextLink from '@/components/text-link.astro';
import { LINKS } from '@/config/links';
import { DOWNLOAD, DOWNLOAD_HEADING } from '@/content/download';
---

<section id="descargar" aria-labelledby="descargar-title" class="navy-grid on-navy relative overflow-hidden text-on-navy" data-section>
  <div class="mx-auto grid max-w-page gap-12 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <div class="relative lg:col-span-7">
      <SectionHeading heading={DOWNLOAD_HEADING} id="descargar-title" accent="silver" dark />
      <div class="mt-10 flex flex-wrap items-center gap-5">
        <ButtonLink href={LINKS.download} size="large">
          <svg class="size-7" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path class="art-thin fill-none stroke-current" d="M12 4 V15 M7 10 L12 15 L17 10 M5 20 H19" />
          </svg>
          {DOWNLOAD.button}
        </ButtonLink>
        <TextLink href={LINKS.repository} class="font-mono text-sm font-semibold hover:decoration-yellow">{DOWNLOAD.github}</TextLink>
      </div>
      <DownloadNote class="mt-4 text-on-navy-soft" />

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <div>
          <h3 class="text-3xl font-extrabold">{DOWNLOAD.stepsTitle}</h3>
          <ol class="mt-4 space-y-3">
            {DOWNLOAD.steps.map((step, index) => (
              <li class="flex gap-3 text-on-navy-soft">
                <span class="grid size-7 shrink-0 place-items-center rounded-full border-2 border-ink bg-yellow font-mono text-sm font-bold text-ink">{index + 1}</span>
                {step}
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h3 class="text-3xl font-extrabold">{DOWNLOAD.needsTitle}</h3>
          <p class="mt-4 text-on-navy-soft">{DOWNLOAD.needs}</p>
        </div>
      </div>

      <div class="art-extra pointer-events-none absolute -top-4 right-0 w-24" aria-hidden="true" data-float>
        <FileTile kind="zip" class="w-full rotate-12" />
      </div>
    </div>

    <div class="relative lg:col-span-5">
      <RetroWindow title={DOWNLOAD.warning.window} accent="sky" class="text-ink">
        <div class="p-6">
          <h3 class="text-2xl font-extrabold md:text-3xl">{DOWNLOAD.warning.title}</h3>
          <p class="mt-3 text-ink-soft">{DOWNLOAD.warning.body}</p>
          <ol class="mt-4 space-y-2">
            {DOWNLOAD.warning.steps.map((step, index) => (
              <li class="flex items-center gap-3 font-semibold">
                <span class="grid size-7 shrink-0 place-items-center rounded-full border-2 border-ink bg-sky font-mono text-sm">{index + 1}</span>
                {step}
              </li>
            ))}
          </ol>
          <p class="mt-5 border-t-2 border-dashed border-paper-deep pt-4 text-sm text-ink-soft">{DOWNLOAD.warning.trust}</p>
        </div>
      </RetroWindow>
      <div class="pointer-events-none absolute -right-3 -bottom-6 w-12" aria-hidden="true" data-float>
        <SparkleArt class="w-full" />
      </div>
    </div>
  </div>
</section>
