---
// 6. Your PC: real captures of Qué ocupa espacio (the map of colors) and Archivos repetidos.
import { Image } from 'astro:assets';
import spaceShot from '@docs/que-ocupa-espacio.webp';
import duplicatesShot from '@docs/archivos-repetidos.webp';
import RetroWindow from '@/components/retro-window.astro';
import SlideFrame from '@/social/slide-frame.astro';
import { SOCIAL } from '@/social/slides';

const SHOTS = [spaceShot, duplicatesShot];
---

<SlideFrame page={6}>
  <h2 class="social-title">{SOCIAL.pc.title}</h2>
  <p class="social-lead mt-6 text-ink-soft">{SOCIAL.pc.lead}</p>

  {/* In a cascade: the second window over the first, so both fit. */}
  <div class="mt-10 flex flex-col">
    {SHOTS.map((shot, index) => (
      <RetroWindow title={SOCIAL.pc.windows[index]} accent="silver" class:list={['relative w-5/6', index === 1 && '-mt-24 self-end']}>
        <Image class="social-shot" src={shot} alt={SOCIAL.pc.alts[index]} widths={[1540]} sizes="770px" format="png" />
      </RetroWindow>
    ))}
  </div>
</SlideFrame>
