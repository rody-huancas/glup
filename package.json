{
  "name": "glup",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "build": "pnpm --filter desktop tauri build",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "version:set": "node scripts/set-version.mjs",
    "sweep": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sweep-target.ps1",
    "sweep:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sweep-target.ps1 -DryRun",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "voz:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-voz.ps1",
    "docs:shots": "node scripts/docs-shots.mjs",
    "web:shots": "node scripts/landing-shots.mjs",
    "social:shots": "node scripts/social-shots.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.65.1",
    "sharp": "0.35.5"
  }
}
