  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter desktop tauri dev",
    "build": "pnpm --filter desktop tauri build",
    "version:set": "node scripts/set-version.mjs",
    "sweep": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sweep-target.ps1",
    "sweep:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sweep-target.ps1 -DryRun",
    "voz:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-voz.ps1"
  }
}
